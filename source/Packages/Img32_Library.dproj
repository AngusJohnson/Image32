<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{638B48C3-6DFB-4C55-87D2-ED3F874C19EF}</ProjectGuid>
        <MainSource>Img32_Library.dpk</MainSource>
        <Base>True</Base>
